{
  "name": "@lokus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LOKUS API — Identity Platform auth, tenant isolation, RBAC.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
