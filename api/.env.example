# Copy to .env for local runs. No real secret belongs in this file or in .env —
# on Cloud Run these come from Secret Manager (infra/cloud_run.tf).

GOOGLE_CLOUD_PROJECT=lokus-ebco-2026
LOKUS_REGION=asia-southeast2
LOKUS_ENVIRONMENT=dev
PORT=8080
LOG_LEVEL=info

# Must match infra/variables.tf identity_platform_tenant_claim.
LOKUS_TENANT_CLAIM=tenantId
LOKUS_ROLES_CLAIM=roles

BQ_MARTS_DATASET=lokus_marts_dev
DOCS_BUCKET=lokus-ebco-2026-lokus-docs-dev
