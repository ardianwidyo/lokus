# Copy to .env for local runs. No real secret belongs in this file or in .env —
# on Cloud Run these come from Secret Manager (infra/cloud_run.tf).

GOOGLE_CLOUD_PROJECT=lokus-ebco-2026
LOKUS_REGION=asia-southeast2
LOKUS_ENVIRONMENT=dev
PORT=8080
LOG_LEVEL=info

# Must match infra/variables.tf identity_platform_tenant_claim.
LOKUS_TENANT_CLAIM=tenantId
LOKUS_ROLES_CLAIM=roles

# Origins allowed to call this API from a browser. Comma separated, exact
# match. Empty means no cross-origin caller is permitted. Never "*" — every
# request carries an Authorization header.
LOKUS_ALLOWED_ORIGINS=http://localhost:5173

BQ_MARTS_DATASET=lokus_marts_dev
DOCS_BUCKET=lokus-ebco-2026-lokus-docs-dev

# Local development only. Accepts unverified identities of the form
# dev:<userId>:<tenantId>:<role>, so the console runs end to end before
# Identity Platform exists. The server REFUSES TO START if this is set while
# NODE_ENV=production. Leave it unset to use real token verification.
# LOKUS_AUTH_MODE=dev
