# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real value. Secrets in production come from Secret Manager (infra/secrets.tf),
# never from a file in the repository.

# --- API (Cloud Run / local) ---------------------------------------------

# Required. The only variable the API refuses to start without.
GOOGLE_CLOUD_PROJECT=demo

# Local development only. Accepts an identity without verifying it, and the
# server refuses to start if this is set while NODE_ENV=production.
LOKUS_AUTH_MODE=dev

# Exact origins allowed to call the API. Never "*": every request carries an
# Authorization header, and a wildcard with credentials is no policy at all.
LOKUS_ALLOWED_ORIGINS=http://localhost:5173

# --- Gemini ---------------------------------------------------------------

# Optional. Get one free at https://aistudio.google.com/apikey — an AI Studio
# key needs no billing account.
#
# Read by the API process only. It must never reach the browser: a key in a
# client bundle is a public key. With no key set, reply drafts and cited
# answers use the deterministic path instead of failing, which is exactly what
# the public demo on GitHub Pages runs.
GEMINI_API_KEY=

# --- Console --------------------------------------------------------------

# Points the console at a running API. Leave unset and it runs the seeded
# dataset in the browser, with no API involved.
VITE_LOKUS_API_URL=http://localhost:8080
