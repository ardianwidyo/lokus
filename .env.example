# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real value. Secrets in production come from Secret Manager (infra/secrets.tf),
# never from a file in the repository.

# --- API (Cloud Run / local) ---------------------------------------------

# Required. The only variable the API refuses to start without.
GOOGLE_CLOUD_PROJECT=demo

# Local development only. Accepts an identity without verifying it, and the
# server refuses to start if this is set while NODE_ENV=production.
LOKUS_AUTH_MODE=dev

# Exact origins allowed to call the API. Never "*": every request carries an
# Authorization header, and a wildcard with credentials is no policy at all.
LOKUS_ALLOWED_ORIGINS=http://localhost:5173

# --- Gemini: Vertex AI or an API key ---------------------------------------

# Which path answers: `vertex`, `apikey`, or anything else for deterministic —
# which is what the public demo on GitHub Pages runs.
#
#   vertex  Application Default Credentials, no stored secret. Locally
#           `gcloud auth application-default login`; on Cloud Run the runtime
#           service account (infra/iam.tf already grants aiplatform.user).
#   apikey  GEMINI_API_KEY below. Free from AI Studio, no billing account.
#
# Both are resolved in the API process only and never reach the browser. A path
# that is not configured cannot be selected, on screen 14 or here.
LOKUS_REASONING=deterministic

# Lets an Admin change the path from screen 14 without a restart. Off by
# default: the choice is process-wide, so one tenant's admin would otherwise
# change how every other tenant's answers are produced.
LOKUS_REASONING_SWITCHABLE=false

# Read only on the `apikey` path. Free at https://aistudio.google.com/apikey.
# Never sent to the browser and never typed into the console: screen 14 selects
# among configured paths, it does not accept a credential.
GEMINI_API_KEY=

# Which Vertex endpoint serves the model. `global` by default: these models are
# not served from asia-southeast2, where the rest of the stack lives — it
# answers 400 FAILED_PRECONDITION. asia-southeast1 works if a region is needed.
GOOGLE_CLOUD_LOCATION=global

# Escape hatch for CI, where no credential file exists:
#   GOOGLE_ACCESS_TOKEN=$(gcloud auth application-default print-access-token)
# Expires in an hour. A service account key file works too, via
# GOOGLE_APPLICATION_CREDENTIALS — prefer workload identity where it exists.
GOOGLE_ACCESS_TOKEN=

# --- Agent Engine (jejak agen) ---------------------------------------------

# Where agent runs and their numbered steps are kept. Unset, they live in this
# process and die with it — fine for tests, thin for a judge who asks to see
# yesterday's trace.
#
# Create one, then paste the resource name it prints:
#   GOOGLE_CLOUD_PROJECT=... node scripts/agent-engine.mjs create
#
# Same credentials as the model path: ADC, no key. The engine holds sessions and
# runs none of our code — the supervisor still runs in this process.
LOKUS_AGENT_ENGINE=

# asia-southeast2 by default, unlike the Gemini endpoint: Agent Engine does
# serve Jakarta, so the tenant's traces stay in region.
LOKUS_AGENT_ENGINE_LOCATION=asia-southeast2

# --- Console --------------------------------------------------------------

# Points the console at a running API. Leave unset and it runs the seeded
# dataset in the browser, with no API involved.
VITE_LOKUS_API_URL=http://localhost:8080
