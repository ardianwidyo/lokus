node_modules/
dist/
coverage/
.vite/

# Local secrets and environment files. Only *.example is committed.
.env
.env.local
.env.*.local

# Terraform: state and any file holding real values.
# .terraform.lock.hcl is committed on purpose — it pins provider versions.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
backend.hcl
crash.log
# A saved plan is a binary snapshot of resource values, sensitive ones included,
# and it is stale the moment the state moves. Regenerate it, never commit it.
tfplan
*.tfplan

.DS_Store
Thumbs.db
# Word writes a lock file beside any .docx that is open. It appears the moment
# someone reads an export in docs/exports/ and vanishes when they close it.
~$*
eval-report.json

# Agent tooling installed into this checkout, not part of LOKUS. Its scripts
# are linted by `eslint .` and account for every error the project's own
# sources do not produce, which made a clean lint run unreadable.
# `.claude/skills/speckit-*` stays tracked on purpose: the Spec Kit workflow is
# evidence of how this repository is built.
.claude/skills/impeccable/
.github/agents/
.github/hooks/
.github/skills/
