{
  "name": "lokus",
  "version": "0.1.0",
  "private": true,
  "description": "LOKUS — operational intelligence console for multi-branch businesses.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "api",
    "web",
    "eval"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace web",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "eval": "npm run eval --workspace @lokus/eval",
    "dev:web": "npm run dev --workspace @lokus/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0"
  }
}
